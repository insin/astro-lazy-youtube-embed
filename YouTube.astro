---
import {getYouTubeEmbed, type YouTubeEmbedOptions} from 'youtube-embed-html'

export type {EmbedParams, Thumbnail, ThumbnailRes, ToggleParam} from 'youtube-embed-html'

type EmbedOptions = Omit<YouTubeEmbedOptions, 'iframeAttributes'>

export interface Props extends
  Omit<astroHTML.JSX.IframeHTMLAttributes, keyof EmbedOptions | 'src' | 'srcdoc'>,
  EmbedOptions {
  /** YouTube thumbnail resolution. Defaults to "sd" (640x480). */
  thumbnailRes?: YouTubeEmbedOptions['thumbnailRes']
}

const {
  aspectRatio,
  cookie,
  copyLink,
  embedParams,
  loading,
  legacy,
  noLink,
  thumbnail,
  thumbnailRes = 'sd',
  title,
  videoId,
  style: customStyle,
  ...iframeAttributes
} = Astro.props as Props

const {style: defaultStyle, ...generatedAttributes} = getYouTubeEmbed({
  aspectRatio,
  cookie,
  copyLink,
  embedParams,
  loading,
  legacy,
  noLink,
  thumbnail,
  thumbnailRes,
  title,
  videoId,
})

let style: astroHTML.JSX.HTMLAttributes['style'] = defaultStyle
if (typeof customStyle === 'string') {
  style = `${defaultStyle};${customStyle}`
} else if (customStyle) {
  const defaults = Object.fromEntries(defaultStyle.split(';').map(declaration => {
    const colon = declaration.indexOf(':')
    return [declaration.slice(0, colon), declaration.slice(colon + 1)]
  }))
  style = {...defaults, ...customStyle}
}
const attributes = {...generatedAttributes, ...iframeAttributes, style}
---
<iframe {...attributes} />
